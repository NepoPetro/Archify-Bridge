{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/NepoPetro/Archify-Bridge/archify-schema.json",
  "title": "Archify Bridge Schema",
  "type": "object",
  "required": ["meta", "nodes", "edges"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title", "type"],
      "properties": {
        "title": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["architecture", "workflow", "sequence", "data-flow", "lifecycle"]
        },
        "visual_preset": { "type": "string" },
        "locale": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "type": { "type": "string" },
          "group": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "label": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}