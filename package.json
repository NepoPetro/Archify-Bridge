{
  "name": "archify-bridge",
  "version": "0.1.0",
  "description": "Bridge between Archify JSON IR and draw.io, Lucidchart, Miro, and Mermaid",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "validate": "node src/utils/validator.js",
    "export:mermaid": "node src/converters/to-mermaid.js",
    "export:drawio": "node src/converters/to-drawio.js",
    "export:all": "npm run export:mermaid && npm run export:drawio"
  },
    "keywords": [
    "archify",
    "drawio",
    "lucidchart",
    "miro",
    "mermaid",
    "diagrams"
  ],
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0"
  }
}